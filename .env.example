# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real secret keys or admin passwords.

STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Long random password for photographer admin (admin.html).
# Example: openssl rand -hex 24
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Created automatically when you add a Blob store in the Vercel project → Storage.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME
